{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build lab1",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-I",
                "${workspaceFolder}/common/src",
                "${workspaceFolder}/lab1/src/main.cpp",
                "${workspaceFolder}/lab1/src/lab1_experiment.cpp",
                "${workspaceFolder}/lab1/src/greedy_methods.cpp",
                "${workspaceFolder}/common/src/experiment.cpp",
                "${workspaceFolder}/common/src/data_reader.cpp",
                "${workspaceFolder}/common/src/random_solution.cpp",
                "-o",
                "${workspaceFolder}/lab1/out/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build lab1 with shared common sources."
        }
    ],
    "version": "2.0.0"
}
